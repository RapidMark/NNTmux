#!/command/with-contenv bash
if [ ! -d /config/mariadb/mysql ]; then
    echo "Initialising MariaDB data directory"
    # On btrfs, copy-on-write makes every page write slow. It can only be
    # turned off while the folder is empty, and not through Unraid's FUSE
    # shares (/mnt/user), so map /config to the pool itself.
    mkdir -p /config/mariadb
    if [ "$(stat -f -c %T /config/mariadb)" = btrfs ] && [ -z "$(ls -A /config/mariadb)" ]; then
        chattr +C /config/mariadb && echo "Copy-on-write turned off for the MariaDB data directory"
    fi
    chown www-data:www-data /config/mariadb
    mariadb-install-db --user=www-data --datadir=/config/mariadb --skip-test-db >/dev/null
fi
exec s6-setuidgid www-data mariadbd \
    --user=www-data \
    --datadir=/config/mariadb \
    --socket=/run/mysqld/mysqld.sock \
    --bind-address=127.0.0.1 \
    --skip-name-resolve \
    --max_allowed_packet=128M \
    --group_concat_max_len=16384 \
    --max_connections=200 \
    --innodb_log_file_size="${DB_INNODB_LOG_FILE_SIZE:-4G}" \
    --innodb_io_capacity="${DB_INNODB_IO_CAPACITY:-4000}" \
    --innodb_io_capacity_max="${DB_INNODB_IO_CAPACITY_MAX:-8000}" \
    --innodb_flush_neighbors=0 \
    --innodb_flush_log_at_trx_commit=2 \
    --innodb_fast_shutdown=2 \
    --transaction-isolation=READ-COMMITTED \
    --tmp_table_size=256M \
    --max_heap_table_size=256M \
    --innodb_buffer_pool_size="${DB_INNODB_BUFFER_POOL_SIZE:-1G}"
